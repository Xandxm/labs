#include <iostream>
#include <string>
#include <cstdlib>
#include <vector>

#ifdef _WIN32
#include <windows.h>
#include <io.h>
#include <fcntl.h>
#endif

using namespace std;

// ============================================================
// НАСТРОЙКИ ЛАБОРАТОРНОЙ
